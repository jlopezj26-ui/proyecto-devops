<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Task Manager · DevOps Project</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <style>
    body { background-color: #f0f2f5; }
    .card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    .table-completed td { text-decoration: line-through; color: #adb5bd; }
    .badge-done  { background-color: #d1fae5; color: #065f46; }
    .badge-pend  { background-color: #fef3c7; color: #92400e; }
    .priority-alta  { border-left: 4px solid #ef4444; }
    .priority-media { border-left: 4px solid #f59e0b; }
    .priority-baja  { border-left: 4px solid #22c55e; }
    .deadline-overdue { color: #ef4444; font-weight: 600; }
    .page-link { border-radius: 8px !important; margin: 0 2px; }
  </style>
</head>
<body>

<%- include('partials/header') %>

<main class="container py-4">
  <div class="row g-4">

    <!-- ── FORMULARIO ── -->
    <div class="col-12 col-md-4">
      <div class="card p-4">

        <% if (editTask) { %>
          <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square me-2 text-warning"></i>Editar tarea</h5>
          <form action="/update/<%= editTask.id %>" method="POST">
            <div class="mb-3">
              <label class="form-label fw-semibold">Título</label>
              <input type="text" name="title" class="form-control"
                     value="<%= editTask.title %>" required />
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Prioridad</label>
              <select name="priority" class="form-select">
                <option value="alta"  <%= editTask.priority === 'alta'  ? 'selected' : '' %>>🔴 Alta</option>
                <option value="media" <%= editTask.priority === 'media' ? 'selected' : '' %>>🟡 Media</option>
                <option value="baja"  <%= editTask.priority === 'baja'  ? 'selected' : '' %>>🟢 Baja</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Fecha límite</label>
              <input type="date" name="deadline" class="form-control"
                     value="<%= editTask.deadline ? editTask.deadline.toISOString().split('T')[0] : '' %>" />
            </div>
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="completed"
                     name="completed" <%= editTask.completed ? 'checked' : '' %> />
              <label class="form-check-label" for="completed">Marcar como completada</label>
            </div>
            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-warning fw-bold">
                <i class="bi bi-save me-1"></i>Guardar cambios
              </button>
              <a href="/" class="btn btn-outline-secondary">Cancelar</a>
            </div>
          </form>

        <% } else { %>
          <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2 text-primary"></i>Nueva tarea</h5>
          <form action="/create" method="POST">
            <div class="mb-3">
              <label class="form-label fw-semibold">Título</label>
              <input type="text" name="title" class="form-control"
                     placeholder="Ej: Configurar CI/CD pipeline" required />
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Prioridad</label>
              <select name="priority" class="form-select">
                <option value="alta">🔴 Alta</option>
                <option value="media" selected>🟡 Media</option>
                <option value="baja">🟢 Baja</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Fecha límite <span class="text-muted fw-normal">(opcional)</span></label>
              <input type="date" name="deadline" class="form-control" />
            </div>
            <div class="d-grid">
              <button type="submit" class="btn btn-primary fw-bold">
                <i class="bi bi-plus-lg me-1"></i>Agregar tarea
              </button>
            </div>
          </form>
        <% } %>

      </div>
    </div>

    <!-- ── TABLA ── -->
    <div class="col-12 col-md-8">
      <div class="card p-4">

        <!-- Barra de búsqueda y filtros -->
        <form method="GET" action="/" class="mb-3">
          <div class="row g-2">
            <div class="col-12 col-sm-5">
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control"
                       placeholder="Buscar tarea..." value="<%= search %>" />
              </div>
            </div>
            <div class="col-6 col-sm-3">
              <select name="filter" class="form-select">
                <option value="all"     <%= filter === 'all'     ? 'selected' : '' %>>Todas</option>
                <option value="pending" <%= filter === 'pending' ? 'selected' : '' %>>Pendientes</option>
                <option value="done"    <%= filter === 'done'    ? 'selected' : '' %>>Completadas</option>
              </select>
            </div>
            <div class="col-6 col-sm-3">
              <select name="priority" class="form-select">
                <option value="all"  <%= priority === 'all'  ? 'selected' : '' %>>Prioridad</option>
                <option value="alta" <%= priority === 'alta' ? 'selected' : '' %>>🔴 Alta</option>
                <option value="media"<%= priority === 'media'? 'selected' : '' %>>🟡 Media</option>
                <option value="baja" <%= priority === 'baja' ? 'selected' : '' %>>🟢 Baja</option>
              </select>
            </div>
            <div class="col-12 col-sm-1 d-grid">
              <button type="submit" class="btn btn-dark">
                <i class="bi bi-funnel"></i>
              </button>
            </div>
          </div>
        </form>

        <% if (tasks.length === 0) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-inbox fs-1"></i>
            <p class="mt-2">No se encontraron tareas.</p>
            <% if (search || filter !== 'all' || priority !== 'all') { %>
              <a href="/" class="btn btn-outline-secondary btn-sm">Limpiar filtros</a>
            <% } %>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>Título</th>
                  <th class="text-center">Prioridad</th>
                  <th class="text-center">Deadline</th>
                  <th class="text-center">Estado</th>
                  <th class="text-center">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% tasks.forEach((task, i) => { %>
                  <%
                    const today    = new Date(); today.setHours(0,0,0,0);
                    const deadline = task.deadline ? new Date(task.deadline) : null;
                    const overdue  = deadline && !task.completed && deadline < today;
                    const offsetNum = (page - 1) * 5;
                  %>
                  <tr class="<%= task.completed ? 'table-completed' : '' %> priority-<%= task.priority %>">
                    <td class="text-muted small"><%= offsetNum + i + 1 %></td>
                    <td><%= task.title %></td>
                    <td class="text-center">
                      <% if (task.priority === 'alta') { %>
                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3">🔴 Alta</span>
                      <% } else if (task.priority === 'media') { %>
                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3">🟡 Media</span>
                      <% } else { %>
                        <span class="badge bg-success-subtle text-success rounded-pill px-3">🟢 Baja</span>
                      <% } %>
                    </td>
                    <td class="text-center small">
                      <% if (deadline) { %>
                        <span class="<%= overdue ? 'deadline-overdue' : 'text-muted' %>">
                          <i class="bi bi-calendar<%= overdue ? '-x' : '' %> me-1"></i>
                          <%= deadline.toLocaleDateString('es-GT', { day:'2-digit', month:'short', year:'numeric' }) %>
                          <% if (overdue) { %><br><span class="badge bg-danger-subtle text-danger">Vencida</span><% } %>
                        </span>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <% if (task.completed) { %>
                        <span class="badge badge-done rounded-pill px-3 py-2">
                          <i class="bi bi-check-circle-fill me-1"></i>Hecha
                        </span>
                      <% } else { %>
                        <span class="badge badge-pend rounded-pill px-3 py-2">
                          <i class="bi bi-clock me-1"></i>Pendiente
                        </span>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <a href="/edit/<%= task.id %>" class="btn btn-sm btn-outline-warning me-1" title="Editar">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <form action="/delete/<%= task.id %>" method="POST" class="d-inline"
                            onsubmit="return confirm('¿Eliminar esta tarea?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- Stats + Paginación -->
          <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <p class="text-muted small mb-0">
              Mostrando <strong><%= tasks.length %></strong> de <strong><%= total %></strong> tarea(s)
            </p>

            <% if (totalPages > 1) { %>
              <nav>
                <ul class="pagination pagination-sm mb-0">
                  <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="/?page=<%= page - 1 %>&search=<%= search %>&filter=<%= filter %>&priority=<%= priority %>">
                      <i class="bi bi-chevron-left"></i>
                    </a>
                  </li>
                  <% for (let p = 1; p <= totalPages; p++) { %>
                    <li class="page-item <%= p === page ? 'active' : '' %>">
                      <a class="page-link" href="/?page=<%= p %>&search=<%= search %>&filter=<%= filter %>&priority=<%= priority %>">
                        <%= p %>
                      </a>
                    </li>
                  <% } %>
                  <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="/?page=<%= page + 1 %>&search=<%= search %>&filter=<%= filter %>&priority=<%= priority %>">
                      <i class="bi bi-chevron-right"></i>
                    </a>
                  </li>
                </ul>
              </nav>
            <% } %>
          </div>
        <% } %>

      </div>
    </div>

  </div>
</main>

<%- include('partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
