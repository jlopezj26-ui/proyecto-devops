<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Task Manager · DevOps Project</title>

  <!-- Bootstrap 5 via CDN -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <!-- Bootstrap Icons via CDN -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  />

  <style>
    body { background-color: #f0f2f5; }
    .card  { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    .table-completed td { text-decoration: line-through; color: #adb5bd; }
    .badge-done { background-color: #d1fae5; color: #065f46; }
    .badge-pend { background-color: #fef3c7; color: #92400e; }
  </style>
</head>

<body>

  <!-- ── HEADER PARTIAL ── -->
  <%- include('partials/header') %>

  <main class="container py-4">
    <div class="row g-4">

      <!-- ── FORMULARIO (Crear / Editar) ── -->
      <div class="col-12 col-md-4">
        <div class="card p-4">

          <% if (editTask) { %>
            <!-- Modo edición -->
            <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square me-2 text-warning"></i>Editar tarea</h5>
            <form action="/update/<%= editTask.id %>" method="POST">
              <div class="mb-3">
                <label for="title" class="form-label fw-semibold">Título</label>
                <input
                  type="text"
                  id="title"
                  name="title"
                  class="form-control"
                  value="<%= editTask.title %>"
                  required
                />
              </div>
              <div class="form-check mb-3">
                <input
                  class="form-check-input"
                  type="checkbox"
                  id="completed"
                  name="completed"
                  <%= editTask.completed ? 'checked' : '' %>
                />
                <label class="form-check-label" for="completed">Marcar como completada</label>
              </div>
              <div class="d-grid gap-2">
                <button type="submit" class="btn btn-warning fw-bold">
                  <i class="bi bi-save me-1"></i>Guardar cambios
                </button>
                <a href="/" class="btn btn-outline-secondary">Cancelar</a>
              </div>
            </form>

          <% } else { %>
            <!-- Modo creación -->
            <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2 text-primary"></i>Nueva tarea</h5>
            <form action="/create" method="POST">
              <div class="mb-3">
                <label for="title" class="form-label fw-semibold">Título</label>
                <input
                  type="text"
                  id="title"
                  name="title"
                  class="form-control"
                  placeholder="Ej: Configurar CI/CD pipeline"
                  required
                />
              </div>
              <div class="d-grid">
                <button type="submit" class="btn btn-primary fw-bold">
                  <i class="bi bi-plus-lg me-1"></i>Agregar tarea
                </button>
              </div>
            </form>
          <% } %>

        </div>
      </div>

      <!-- ── TABLA DE TAREAS ── -->
      <div class="col-12 col-md-8">
        <div class="card p-4">
          <h5 class="fw-bold mb-3"><i class="bi bi-list-check me-2 text-success"></i>Mis tareas</h5>

          <% if (tasks.length === 0) { %>
            <div class="text-center text-muted py-5">
              <i class="bi bi-inbox fs-1"></i>
              <p class="mt-2">No hay tareas todavía. ¡Agrega una!</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>#</th>
                    <th>Título</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% tasks.forEach((task, i) => { %>
                    <tr class="<%= task.completed ? 'table-completed' : '' %>">
                      <td class="text-muted small"><%= i + 1 %></td>
                      <td><%= task.title %></td>
                      <td class="text-center">
                        <% if (task.completed) { %>
                          <span class="badge badge-done rounded-pill px-3 py-2">
                            <i class="bi bi-check-circle-fill me-1"></i>Hecha
                          </span>
                        <% } else { %>
                          <span class="badge badge-pend rounded-pill px-3 py-2">
                            <i class="bi bi-clock me-1"></i>Pendiente
                          </span>
                        <% } %>
                      </td>
                      <td class="text-center">
                        <!-- Botón Editar -->
                        <a href="/edit/<%= task.id %>" class="btn btn-sm btn-outline-warning me-1" title="Editar">
                          <i class="bi bi-pencil"></i>
                        </a>
                        <!-- Botón Eliminar -->
                        <form action="/delete/<%= task.id %>" method="POST" class="d-inline"
                              onsubmit="return confirm('¿Eliminar esta tarea?')">
                          <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <p class="text-muted small mt-3 mb-0">
              Total: <strong><%= tasks.length %></strong> tarea(s) ·
              Completadas: <strong><%= tasks.filter(t => t.completed).length %></strong>
            </p>
          <% } %>
        </div>
      </div>

    </div><!-- /row -->
  </main>

  <!-- ── FOOTER PARTIAL ── -->
  <%- include('partials/footer') %>

  <!-- Bootstrap 5 JS via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
